{
  // ── Cloudflare Worker 設定 ──────────────────────────────────────
  "name": "taichung-house-analyst",
  "main": "worker/index.js",
  "compatibility_date": "2026-01-01",
  // 靜態資源：掛載 Quasar build 產出的 SPA
  "assets": {
    "directory": "./dist/spa",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // 讓 Worker 先處理 API 路徑（否則 SPA fallback 會把它們也吃成 index.html）；
    // 其餘路徑仍由靜態資源直接服務（含 SPA fallback）。
    // 注意 /owner 本身不列入：那是擁有者的頁面，要走 SPA fallback 回 index.html。
    "run_worker_first": [
      "/api/*",
      "/owner/api/*"
    ]
  },
  // KV：單一 namespace，鍵為 house_data / meta
  // 部署前請以 `wrangler kv namespace create KV` 建立，並把回傳的 id 填入下方。
  "kv_namespaces": [
    {
      "binding": "HOUSES_KV",
      "id": "8d3ac389a63943d38ca889cc33d4c0db"
    }
  ],
  // Cron：每分鐘觸發；實際是否抓取由 worker 依 meta.nextRunAt 閘門判斷
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}